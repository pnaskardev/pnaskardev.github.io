---
import { Icon } from 'astro-icon/components';
import type { Project } from '~/site.config';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<!--
  Compact two-column grid, deliberately borderless.

  The writing section directly above is a full-bleed list of bordered rows with
  a date gutter. If work were also a bordered row list the two sections would
  stack as one undifferentiated run of horizontal rules. Splitting work into
  columns with no rules gives it its own layout family while staying on the same
  type scale and palette.
-->
<ul class="grid gap-x-14 gap-y-10 sm:grid-cols-2 sm:gap-y-12">
  {
    projects.map((project, i) => (
      <li data-reveal style={`--reveal-delay:${Math.min(i, 6) * 70}ms`}>
        <a
          href={project.href}
          target={project.href.startsWith('http') ? '_blank' : undefined}
          rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="group block"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="flex items-center gap-1.5 text-[17px] font-medium tracking-tight text-ink transition-colors group-hover:text-accent">
              {project.title}
              <Icon
                name="ph:arrow-up-right"
                width={13}
                height={13}
                class="text-faint transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
              />
            </h3>
            <span class="shrink-0 font-mono text-xs text-faint tabular-nums">
              {project.year}
            </span>
          </div>

          <p class="mt-2 max-w-[46ch] text-[15px] leading-relaxed text-muted">
            {project.blurb}
          </p>

          <p class="mt-3 font-mono text-[11px] text-faint">
            {project.stack.join('  /  ')}
          </p>
        </a>
      </li>
    ))
  }
</ul>
