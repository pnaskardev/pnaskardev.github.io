---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
  /** The index page shows the description; the home page keeps it tighter. */
  showDescription?: boolean;
}

const { post, index = 0, showDescription = true } = Astro.props;

const date = post.data.pubDate;
const iso = date.toISOString();
const label = date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<li data-reveal style={`--reveal-delay:${index * 70}ms`}>
  <a
    href={`/blog/${post.id}/`}
    class="group grid gap-x-8 gap-y-2 border-t border-line-soft py-6 transition-colors last:border-b hover:border-line focus-visible:border-line sm:grid-cols-[8.5rem_1fr]"
  >
    <time
      datetime={iso}
      class="font-mono text-xs text-faint tabular-nums transition-colors group-hover:text-accent sm:pt-1"
    >
      {label}
    </time>

    <div>
      <h3
        class="text-[17px] font-medium leading-snug tracking-tight text-ink transition-colors group-hover:text-accent"
      >
        {post.data.title}
      </h3>

      {
        showDescription && (
          <p class="mt-1.5 max-w-[58ch] text-[15px] leading-relaxed text-muted">
            {post.data.description}
          </p>
        )
      }

      {
        post.data.tags.length > 0 && (
          <p class="mt-3 font-mono text-[11px] text-faint">
            {post.data.tags.join('  /  ')}
          </p>
        )
      }
    </div>
  </a>
</li>
