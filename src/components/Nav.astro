---
import { site } from '~/site.config';

/**
 * Single-line nav, 64px tall. Anchors are root-relative so the same links work
 * from /blog/* as they do from the home page.
 */
const links = [
  { label: 'Writing', href: '/blog' },
  { label: 'Work', href: '/#work' },
  { label: 'Now', href: '/#now' },
  { label: 'Contact', href: '/#contact' },
];

const path = Astro.url.pathname;
const isWriting = path.startsWith('/blog');
---

<header
  class="sticky top-0 z-50 h-16 border-b border-line-soft bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex h-full max-w-[1180px] items-center justify-between px-5 sm:px-8"
  >
    <a
      href="/"
      class="group font-mono text-sm tracking-tight text-ink transition-colors hover:text-accent"
    >
      <span class="text-accent">/</span>{site.handle}
    </a>

    <ul class="flex items-center gap-5 sm:gap-7">
      {
        links.map((link) => {
          const active = link.href === '/blog' && isWriting;
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'text-[13px] transition-colors sm:text-sm',
                  active ? 'text-ink' : 'text-muted hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
