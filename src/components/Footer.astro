---
import { Icon } from 'astro-icon/components';
import { site, socials } from '~/site.config';

const year = new Date().getFullYear();
---

<footer class="border-t border-line-soft">
  <div
    class="mx-auto flex max-w-[1180px] flex-col gap-6 px-5 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p class="font-mono text-xs text-faint">
      &copy; {year} {site.name}
    </p>

    <div class="flex items-center gap-5">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="me noopener noreferrer"
            aria-label={s.label}
            class="text-faint transition-colors hover:text-accent"
          >
            <Icon name={s.icon} width={18} height={18} />
          </a>
        ))
      }
      <a
        href="/rss.xml"
        aria-label="RSS feed"
        class="text-faint transition-colors hover:text-accent"
      >
        <Icon name="ph:rss-simple" width={18} height={18} />
      </a>
    </div>
  </div>
</footer>
