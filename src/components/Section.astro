---
interface Props {
  id?: string;
  heading?: string;
  /** Renders the hairline rule above the section. Off for the first section. */
  rule?: boolean;
  class?: string;
}

const { id, heading, rule = true, class: className = '' } = Astro.props;
---

<section id={id} class:list={['mx-auto max-w-[1180px] px-5 sm:px-8', className]}>
  {rule && <hr class="border-0 border-t border-line-soft" />}

  <div class="py-20 sm:py-28">
    {
      heading && (
        <h2
          data-reveal
          class="mb-12 text-2xl font-medium tracking-tight text-ink sm:mb-14 sm:text-[1.75rem]"
        >
          {heading}
        </h2>
      )
    }
    <slot />
  </div>
</section>
