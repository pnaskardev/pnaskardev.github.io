---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import WorkGrid from '~/components/WorkGrid.astro';
import PostRow from '~/components/PostRow.astro';
import { site, socials, projects, now, HOME_POST_COUNT } from '~/site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, HOME_POST_COUNT);
---

<Base>
  {/* Hero: asymmetric split. Type carries the left, portrait anchors the right. */}
  <section class="mx-auto max-w-[1180px] px-5 pt-16 pb-20 sm:px-8 sm:pt-24 sm:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-20">
      <div>
        <h1
          data-reveal
          class="max-w-[16ch] text-4xl font-medium leading-[1.08] tracking-[-0.03em] text-ink sm:text-5xl lg:text-[3.4rem]"
        >
          {site.headline}
        </h1>

        <p
          data-reveal
          style="--reveal-delay:110ms"
          class="mt-6 max-w-[46ch] text-[17px] leading-relaxed text-muted"
        >
          {site.intro}
        </p>

        <div
          data-reveal
          style="--reveal-delay:200ms"
          class="mt-9 flex items-center gap-6"
        >
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="me noopener noreferrer"
                class="group flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
              >
                <Icon name={s.icon} width={17} height={17} />
                <span>{s.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      {
        site.portrait && (
          /*
           * Text first in DOM order so the headline and links own the fold on
           * mobile. The 3:2 band keeps the image from eating the viewport;
           * it only becomes a 4:5 portrait once it has its own column at lg.
           */
          <div data-reveal style="--reveal-delay:160ms">
            <img
              src={site.portrait.src}
              alt={site.portrait.alt}
              width="1200"
              height="1500"
              fetchpriority="high"
              decoding="async"
              class="aspect-[3/2] w-full rounded-[4px] border border-line object-cover lg:aspect-[4/5]"
            />
          </div>
        )
      }
    </div>
  </section>

  {/* Writing leads the page. The post list is the front door, not a teaser. */}
  <Section id="writing" heading="Writing">
    {
      posts.length > 0 ? (
        <>
          <ul class="grid">
            {posts.map((post, i) => (
              <PostRow post={post} index={Math.min(i, 6)} />
            ))}
          </ul>

          <a
            data-reveal
            href="/blog"
            class="group mt-10 inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
          >
            All posts
            <Icon
              name="ph:arrow-right"
              width={14}
              height={14}
              class="transition-transform duration-300 group-hover:translate-x-1"
            />
          </a>
        </>
      ) : (
        <p data-reveal class="max-w-[52ch] text-[15px] leading-relaxed text-muted">
          No posts published yet. The first one is being written.
        </p>
      )
    }
  </Section>

  {/* Work supports the writing rather than leading. Compact, text only. */}
  <Section id="work" heading="Selected work">
    <WorkGrid projects={projects} />
  </Section>

  {/* Grouped columns. Deliberately not a flat skills list. */}
  <Section id="now" heading="Now">
    <div class="grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        now.map((group, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <h3 class="font-mono text-xs text-accent-dim">{group.heading}</h3>
            <ul class="mt-4 grid gap-2.5">
              {group.items.map((item) => (
                <li class="text-[15px] leading-relaxed text-muted">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  {/* Full-width type block. The only contact CTA on the page. */}
  <Section id="contact">
    <div data-reveal class="py-4">
      <h2 class="max-w-[18ch] text-3xl font-medium leading-[1.12] tracking-[-0.03em] text-ink sm:text-[2.5rem]">
        Get in touch
      </h2>
      <p class="mt-5 max-w-[46ch] text-[17px] leading-relaxed text-muted">
        Open to interesting problems and good conversation about systems.
      </p>
      <a
        href={`mailto:${site.email}`}
        class="group mt-8 inline-flex items-center gap-2.5 rounded-[4px] bg-accent px-5 py-3 text-sm font-medium text-bg transition-all duration-200 hover:bg-[#f2b155] active:translate-y-px"
      >
        {site.email}
        <Icon
          name="ph:arrow-up-right"
          width={15}
          height={15}
          class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </Section>
</Base>
